# ============================================================
# Chess64 — Single .env file for docker compose up
#
# 1. Set PUBLIC_IP to your EC2's public IP or domain
# 2. Fill in the secrets below
# 3. Run: docker compose up -d
# ============================================================

# ---------- Your EC2 Public IP ----------
# Change this ONE value and all services pick it up automatically.
PUBLIC_IP=localhost

# ---------- Data stores (internal Docker network, don't change) ----------
MONGODB_URL=mongodb://mongo:27017/64
REDIS_URL=redis://redis:6379

# ---------- Auth / Mail ----------
JWT_TOKEN_SECRET=CHANGE_ME_jwt_secret_1
JWT_TOKEN_SIGNUP_MAIL_SECRET=CHANGE_ME_jwt_secret_2
JWT_RESET_PASSWORD_SECRET=CHANGE_ME_jwt_secret_3
NODEMAILER_MAIL=your-email@gmail.com
NODEMAIL_APP_PASSWORD=your-gmail-app-password

# ---------- Stockfish user (treated as a regular user in DB) ----------
STOCKFISH_EMAIL=stockfish@chess64.com
STOCKFISH_PASSWORD=Stockfish@123!
